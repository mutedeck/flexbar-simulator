{
  "name": "flexbar-simulator",
  "version": "0.1.0",
  "description": "Protocol-level FlexDesigner + Flexbar simulator for developing Flexbar (FlexDesigner v1) plugins without hardware",
  "license": "MIT",
  "author": "MuteDeck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutedeck/flexbar-simulator.git"
  },
  "homepage": "https://github.com/mutedeck/flexbar-simulator#readme",
  "bugs": {
    "url": "https://github.com/mutedeck/flexbar-simulator/issues"
  },
  "keywords": [
    "flexbar",
    "flexdesigner",
    "eniac",
    "plugin",
    "simulator"
  ],
  "type": "module",
  "bin": {
